<resources>
    <style name="PhoneTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B8E8DA</item>
        <item name="android:windowBackground">#09151F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/PhoneDialog</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="PhoneDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B8E8DA</item>
        <item name="android:windowBackground">@drawable/phone_dialog</item>
        <item name="android:textColorPrimary">#E3F3EE</item>
        <item name="android:textColorSecondary">#BCD2D0</item>
    </style>
</resources>
